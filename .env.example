# Copy this file to .env and fill in the values. Never commit .env.
# Do not paste the API key, SMTP password or any clerk password into chat tools.

# --- TASK API -------------------------------------------------------------
# UAT: https://madmexuatapi.xchangefusion.com   (switch to the production host when going live)
TASK_BASE_URL=https://madmexuatapi.xchangefusion.com
# API key for this app, issued by the TASK administrator. Sent as the "Key" header.
# Required unless the admin panel is enabled (then it can be set in /admin instead).
TASK_API_KEY=
# Default sign-in type shown on the login form:
# 0 = Email, 1 = Clerk ID, 2 = Clerk alpha name, 3 = Clerk logon
TASK_LOGIN_TYPE=0
# TASK paging: page number of the first page (check in UAT; 1 or 0) and page size.
TASK_FIRST_PAGE_NO=1
TASK_PAGE_SIZE=100
TASK_TIMEOUT_MS=20000

# --- Live product checks --------------------------------------------------
# Supplier, supplier product code, venue cost and product data are read live from TASK
# every time (no caching). Products are only offered when the supplier is active, the
# supplier product code is available, the product is active in TASK and (if true below)
# the supplier has a cost for the location's venue.
REQUIRE_VENUE_COST=true
# Parallel GET /products/{id} requests when checking product status (1-20).
PRODUCT_LOOKUP_CONCURRENCY=6

# --- Admin panel (Microsoft Entra ID sign-in) -----------------------------
# Leave ENTRA_* blank to turn the admin panel off.
# With it on, the TASK address and key above are only starting values: whatever an
# administrator saves at /admin is used by the whole app from then on.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Client secret from the Entra app registration. Keep it in .env or your secret store only.
ENTRA_CLIENT_SECRET=
# This app's public https address. Entra sends people back to PUBLIC_BASE_URL/admin/callback.
PUBLIC_BASE_URL=
# Who may open the admin panel. Your Entra object ID is recommended because it never changes
# (the panel shows it after you sign in). If both are set, both must match.
ADMIN_ALLOWED_OBJECT_IDS=
ADMIN_ALLOWED_USERS=
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=8
# 32 random bytes (base64) that encrypt the saved API key. Generate with: openssl rand -base64 32
# Keep it safe and unchanged: if it changes, the saved settings can't be read.
SETTINGS_ENCRYPTION_KEY=
# Folder for the saved settings and the admin change history. Must be on persistent storage.
DATA_DIR=data
# Servers the TASK address may point at (comma-separated; *.domain allows its subdomains).
# Not editable in the admin panel, so a stolen admin session can't send clerk passwords elsewhere.
TASK_ALLOWED_HOSTS=*.xchangefusion.com
# Name shown to clerks for the TASK environment, e.g. UAT or Production (can be changed in /admin).
TASK_ENVIRONMENT_NAME=

# --- Central hub (Supabase) -> TASK clerk sync -----------------------------
# The hub is the master list of staff. Leave HUB_SUPABASE_URL blank to turn the sync off.
# Needs the admin panel (ENTRA_*) for previews and approvals.
HUB_SUPABASE_URL=
# A Supabase key that can READ the hub table/view below (server-side only; never in the browser).
# Keep it in .env or your secret store only.
HUB_SUPABASE_KEY=
HUB_ALLOWED_HOSTS=*.supabase.co
HUB_SCHEMA=public
# Table or (recommended) a view exposing only the columns below.
HUB_TABLE=
# Column names in the hub. Only these columns are ever read.
HUB_COL_ID=id
HUB_COL_FIRST_NAME=first_name
HUB_COL_LAST_NAME=last_name
HUB_COL_EMAIL=email
# true/false or text like active/inactive. Blank = everyone in the hub counts as active.
HUB_COL_ACTIVE=is_active
# Optional
HUB_COL_MOBILE=
HUB_COL_PAYROLL_ID=
HUB_COL_VENUE_NO=
HUB_COL_CLERK_LOGON=
# The TASK clerk the sync signs in as. It needs permission to view and edit clerks.
SYNC_TASK_LOGIN_TYPE=0
SYNC_TASK_LOGIN=
SYNC_TASK_PASSWORD=
# New clerks are created in this TASK clerk group and home venue (unless HUB_COL_VENUE_NO is set).
SYNC_NEW_CLERK_GROUP_ID=
SYNC_NEW_CLERK_VENUE_NO=
# Automatic sync every N minutes (0 = only when you press Sync now in the admin panel).
SYNC_INTERVAL_MINUTES=15
# The automatic sync holds back runs with more deactivations / new clerks than this
# (you can apply them from Sync now after checking the preview).
SYNC_MAX_DEACTIVATIONS=10
SYNC_MAX_CREATIONS=25

# --- Web server -----------------------------------------------------------
PORT=3000
# Clerks are signed out after this many idle minutes (and when the browser closes).
SESSION_IDLE_MINUTES=30
# Set to true when served over HTTPS (default: true when NODE_ENV=production).
COOKIE_SECURE=
# Number of proxies in front of the app, so the sign-in rate limiter sees each clerk's real IP.
# Azure App Service behind Cloudflare: 2.
TRUST_PROXY=
# Only serve requests that came through Cloudflare: a Cloudflare Transform Rule adds the header
# X-Origin-Verify with this value (at least 32 characters, e.g. openssl rand -hex 32). /healthz is exempt.
# While rotating, list the old and new values separated by a comma.
CLOUDFLARE_ORIGIN_SECRET=
# Supplier POs show the Ordered time in each store's own time zone, from the store's TimeZoneId in TASK
# (or its state if that's blank). DISPLAY_TIMEZONE is used only when a store's time zone can't be worked out.
DISPLAY_TIMEZONE=Australia/Sydney
# The time zone TASK means when it returns a time with no time zone (e.g. 2026-11-05T10:19:57).
# Defaults to DISPLAY_TIMEZONE. Compare one PO's Ordered time with TASK; if it's out by hours, try UTC.
TASK_TIME_ZONE=
COMPANY_NAME=Mad Mex

# --- Supplier email -------------------------------------------------------
# log  = do not send; write each email to ./outbox (use this for UAT testing)
# smtp = send through the SMTP relay below
MAIL_MODE=log
MAIL_FROM=
# Optional copy of every PO email, e.g. a purchasing inbox. Comma-separated.
MAIL_CC=
MAIL_OUTBOX_DIR=outbox
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
